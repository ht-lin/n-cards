# --- 机密（§14：.env 绝不入库） ---
.env
.env.*
!.env.example
*.pem
*.key
!infra/vault/*.hcl
secrets/
*.decrypted

# --- Node（仓库级工具链：commitlint / spectral / openapi-generator） ---
node_modules/

# --- PHP / Symfony（T-002 起） ---
backend/vendor/
backend/var/
backend/.php-cs-fixer.cache
backend/.phpunit.result.cache
backend/public/bundles/
# Symfony 每次 cache:warmup 自动生成的 IDE 辅助文件，不入库
backend/config/reference.php

# Symfony dotenv：上面的 `.env` / `.env.*` 是一刀切（§14），这里开两个窄口。
# `backend/.env` 与 `backend/.env.test` 是 Symfony 约定的**默认值**文件，
# 只放非密钥配置，入库是 Symfony 的标准做法（缺了它们 bin/console 直接起不来）。
# 真实密钥走 `.env.local` / `.env.*.local`（仍被上面的 `.env.*` 全部忽略），
# staging/prod 由容器环境变量与 sops(age) 下发（T-003 / T-012）。
!backend/.env
!backend/.env.test

# --- Android / Gradle（T-008 起） ---
.gradle/
# ⚠️ `build/` 匹配**任意层级**上名为 build 的目录，包括 Kotlin 的包目录。
# T-008 的 convention plugin 因此用包名 `de.ncards.buildlogic` 而不是
# `de.ncards.build` —— 后者的源码会被这一行静默吞掉，`git add -A` 之后
# build-logic 里一个 .kt 都不会入库，而本地构建照样是绿的。
build/
android/local.properties
android/captures/
android/.cxx/
*.apk
*.aab
*.keystore
*.jks

# --- IDE ---
.idea/
*.iml
.vscode/
.fleet/

# --- OS ---
.DS_Store
Thumbs.db
