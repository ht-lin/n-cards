# {{ ansible_managed }}
#
# 由 infra/ansible/roles/ncards_stack/templates/env.j2 渲染（T-012）。
# **不要手改这个文件** —— 下一次部署会原样覆盖掉。要改值就改
# inventory/group_vars/<环境>/secrets.sops.yaml（`sops` 打开即可）或 main.yml。
#
# 位置与 compose 文件同目录是**刻意**的：compose 的 project directory 取 `-f`
# 第一个文件所在目录，只有同目录才会被自动加载。放到别处不会报错 ——
# 所有变量都有 ${VAR:-default} 兜底，于是它会静默地用默认值起来。

# --- Symfony ---------------------------------------------------------------
APP_ENV=prod
APP_SECRET={{ APP_SECRET }}
LOG_LEVEL={{ ncards_log_level }}

# --- 镜像 ------------------------------------------------------------------
# 由部署流程写入（CI 传 commit sha）。回滚就是把这一行换回上一个 tag，
# 上一个值记在 {{ ncards_state_path }}/previous-image。
APP_IMAGE={{ ncards_app_image }}

# --- Caddy -----------------------------------------------------------------
# 不带 scheme：裸域名才会触发 Caddy 的自动 TLS 与 80→443 重定向。
CADDY_SITE_ADDRESS={{ ncards_site_address }}
# T-106：App Links 域（落地页 + assetlinks.json）。与上面的 API 域是**两个**
# 站点块，同一个 Caddy 进程。⚠️ 它必须与 APP_PUBLIC_BASE_URL 指向同一个地方 ——
# 那边决定邮件里写哪儿，这边决定页面在哪儿。对不上就是死链，且没有任何测试会红。
CADDY_APP_SITE_ADDRESS={{ ncards_app_site_address }}
ACME_EMAIL={{ ncards_acme_email }}
ACME_CA={{ ncards_acme_ca }}

# --- Postgres --------------------------------------------------------------
POSTGRES_DB=ncards
POSTGRES_USER=ncards
POSTGRES_PASSWORD={{ POSTGRES_PASSWORD }}

# --- Vault -----------------------------------------------------------------
# 生产/staging 走 AppRole，不用 root token（§7.4 / §17.4）。
# 首启时这两个值是 pending-bootstrap-see-runbook 占位符 —— 那时 Vault 还没
# init。VaultHealthCheck 只打免认证的 sys/health，所以 unseal 之后
# /health/ready 照样 200，只有真正的涉密请求才 503。
# 拿到真值后 `sops` 改回 secrets.sops.yaml，重跑部署。
VAULT_ROLE_ID={{ VAULT_ROLE_ID }}
VAULT_SECRET_ID={{ VAULT_SECRET_ID }}

# dev 模式的 root token 在这里显式置空。prod overlay 已经把 VAULT_TOKEN 清空了，
# 但 base 里还引用了这个变量 —— 留空值比留个空缺清楚。
VAULT_DEV_ROOT_TOKEN_ID=

# --- 邮件通道（T-102 / §3.1 / §3.2 / §8.3）---------------------------------
# ⚠️ MAILER_DSN **是凭据**（含服务商的 SMTP 用户名与口令），与 VAULT_SECRET_ID
# 同一口径：在 secrets.sops.yaml 里，绝不入明文库、绝不进 CI 日志。
#
# docker-compose.prod.yml 把它设成了必填（`${MAILER_DSN:?}`）—— 缺失时 compose
# 直接拒绝启动。这道闸是刻意的：回落到 null:// 的症状是「所有人都登不进去，
# 但每一条日志都是绿的」，那是最难诊断的一类故障。
#
# R1（发信通道故障 / 域名被拉黑）的处置就是改这一行 + 重启 worker，
# 步骤见 docs/runbooks/email-dns.md。
MAILER_DSN={{ MAILER_DSN }}

# 发件人。SPF / DKIM / DMARC 必须配在这个地址的域上，否则几乎必进垃圾箱（§3.2）。
MAIL_FROM_ADDRESS={{ ncards_mail_from_address }}
MAIL_FROM_NAME={{ ncards_mail_from_name }}

# §14.4 `email_send_total{provider,template,result}` 的 provider 标签。
# Q3 已决（ADR-0013）：n-cards.de 的域名邮箱，托管方 dogado GmbH。
# 取值在 group_vars 的 ncards_mail_provider，那里也记着这个通道的配额天花板。
MAIL_PROVIDER={{ ncards_mail_provider }}

# --- 信里指回 App 的链接（T-104 / §7.1）------------------------------------
# 新设备登录提醒信里那个「这不是我」链接的基地址。
#
# ⚠️ 指向**客户端**域（app.n-cards.de），不是 API 域 —— Android 注册了
# `https://app.n-cards.de/l/*` 的 App Links，装了 App 的用户点信里的链接
# 会直接拉起 App。两个域名归属不同，别共用一个变量。
# T-106 的 Magic Link 会复用它。
APP_PUBLIC_BASE_URL={{ ncards_app_public_base_url }}
