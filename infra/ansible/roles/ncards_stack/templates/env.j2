# {{ ansible_managed }}
#
# 由 infra/ansible/roles/ncards_stack/templates/env.j2 渲染（T-012）。
# **不要手改这个文件** —— 下一次部署会原样覆盖掉。要改值就改
# inventory/group_vars/<环境>/secrets.sops.yaml（`sops` 打开即可）或 main.yml。
#
# 位置与 compose 文件同目录是**刻意**的：compose 的 project directory 取 `-f`
# 第一个文件所在目录，只有同目录才会被自动加载。放到别处不会报错 ——
# 所有变量都有 ${VAR:-default} 兜底，于是它会静默地用默认值起来。

# --- Symfony ---------------------------------------------------------------
APP_ENV=prod
APP_SECRET={{ APP_SECRET }}
LOG_LEVEL={{ ncards_log_level }}

# --- 镜像 ------------------------------------------------------------------
# 由部署流程写入（CI 传 commit sha）。回滚就是把这一行换回上一个 tag，
# 上一个值记在 {{ ncards_state_path }}/previous-image。
APP_IMAGE={{ ncards_app_image }}

# --- Caddy -----------------------------------------------------------------
# 不带 scheme：裸域名才会触发 Caddy 的自动 TLS 与 80→443 重定向。
CADDY_SITE_ADDRESS={{ ncards_site_address }}
ACME_EMAIL={{ ncards_acme_email }}
ACME_CA={{ ncards_acme_ca }}

# --- Postgres --------------------------------------------------------------
POSTGRES_DB=ncards
POSTGRES_USER=ncards
POSTGRES_PASSWORD={{ POSTGRES_PASSWORD }}

# --- Vault -----------------------------------------------------------------
# 生产/staging 走 AppRole，不用 root token（§7.4 / §17.4）。
# 首启时这两个值是 pending-bootstrap-see-runbook 占位符 —— 那时 Vault 还没
# init。VaultHealthCheck 只打免认证的 sys/health，所以 unseal 之后
# /health/ready 照样 200，只有真正的涉密请求才 503。
# 拿到真值后 `sops` 改回 secrets.sops.yaml，重跑部署。
VAULT_ROLE_ID={{ VAULT_ROLE_ID }}
VAULT_SECRET_ID={{ VAULT_SECRET_ID }}

# dev 模式的 root token 在这里显式置空。prod overlay 已经把 VAULT_TOKEN 清空了，
# 但 base 里还引用了这个变量 —— 留空值比留个空缺清楚。
VAULT_DEV_ROOT_TOKEN_ID=
