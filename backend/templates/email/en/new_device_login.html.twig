{% extends 'email/_layout.html.twig' %}

{% block content %}
    <p style="margin: 0 0 20px 0;">Your N-Cards account was signed in on a new device.</p>

    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 24px 0; border-collapse: collapse; font-size: 15px;">
        <tr>
            <td style="padding: 4px 16px 4px 0; color: #71717a;">Device</td>
            <td style="padding: 4px 0;">{{ device_model }}</td>
        </tr>
        <tr>
            <td style="padding: 4px 16px 4px 0; color: #71717a;">Time</td>
            <td style="padding: 4px 0;">{{ occurred_at }}</td>
        </tr>
        <tr>
            <td style="padding: 4px 16px 4px 0; color: #71717a;">Region</td>
            <td style="padding: 4px 0;">{{ approximate_region }}</td>
        </tr>
    </table>

    <p style="margin: 0 0 20px 0;">Was this you? Then there's nothing to do.</p>

    {# 撤销同样走 POST 确认（§7.1）。落地页归 T-105。 #}
    <p style="margin: 0 0 24px 0;">
        <a href="{{ revoke_url }}" style="display: inline-block; padding: 12px 24px; background-color: #b91c1c; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 600;">This wasn't me — revoke access</a>
    </p>

    <p style="margin: 0; color: #71717a; font-size: 13px; word-break: break-all;">{{ revoke_url }}</p>
{% endblock %}

{% block footer %}
    <p style="margin: 0 0 8px 0;">The region is estimated roughly from the internet connection and may differ from the actual location.</p>
    <p style="margin: 0;">This message was sent automatically. Replies are not read.</p>
{% endblock %}
