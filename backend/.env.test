# test 环境默认值（入库）。同样只放非密钥内容。
APP_SECRET=test-only-not-a-secret

# tests/Integration 里需要真实 PG 的用例连这里。连不上时用例自行 markTestSkipped，
# 所以在没起 compose 栈的开发机上 `composer test` 依然全绿。
# 实际库名会被 config/packages/doctrine.yaml 的 when@test 追加 `_test` 后缀。
DATABASE_URL=postgresql://ncards:ncards@127.0.0.1:5432/ncards

# tests/Integration 里需要真实 Redis 的用例连这里（T-004 的幂等存储）。
# 同样：连不上时用例自行 markTestSkipped，裸机 `composer test` 保持全绿。
REDIS_URL=redis://127.0.0.1:6379

# tests/Integration 里需要真实 Vault 的用例连这里（T-005 的加密门面）。
# 同样：连不上时用例自行 markTestSkipped，裸机 `composer test` 保持全绿。
# token 是 compose dev 模式与 CI service 容器的固定 root token。
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-only-root-token

# 留空 → VaultTokenProviderFactory 走 StaticTokenProvider。
# tests/Integration/Shared/Vault/AppRolePolicyTest 不读这两个变量，
# 它自己用 bootstrap.sh 建出来的 role 现场登录 —— 那条用例验的正是 policy 本身。
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# 测试里对客户端版本的判定必须是**显式**的：默认放行一切，
# 需要验 426 client_too_old 的用例自己覆盖这个容器参数。
MIN_SUPPORTED_CLIENT="android/0.0.0 (1)"
