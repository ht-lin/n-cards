<?xml version="1.0" encoding="UTF-8"?>
<!--
  ⚠️ **德语是默认语言。** 本文件（values/）放德语，英语在 values-en/。
  §11.1 原文：「默认资源目录放德语，因为主要市场是德国，且避免『英语兜底』
  在德语环境下漏翻」。

  **不要**把这份挪到 values-de/ 再把英语搬进来。那一刻起，德语环境下每一条
  漏翻的文案都会静默显示英语，而 MissingTranslation 只查反方向、查不出来。
  checkGermanIsDefaultLocale 任务会拦下这个改动（见 build-logic/…/GermanDefaultLocale.kt）。

  tools:locale="de" 让 IDE 与 lint 按德语做拼写检查；不写的话会产出一堆假告警，
  然后所有人开始忽略这一类告警。
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="de">

    <string name="app_name">N-Cards</string>

    <!--
      「上一次为什么被登出」。四格里只有两格要说话 —— SignedOutReason 的
      类注释解释了为什么它们不能合并成一句（尤其 KeyMaterialLost）。
    -->
    <string name="signed_out_title">Du bist abgemeldet</string>
    <string name="signed_out_session_revoked">Deine Sitzung ist abgelaufen oder wurde beendet. Bitte melde dich erneut an.</string>
    <string name="signed_out_key_material_lost">Die Daten auf diesem Gerät lassen sich nicht mehr entschlüsseln – das passiert zum Beispiel nach einer Systemwiederherstellung. Melde dich erneut an; deine Karten werden dann neu geladen.</string>
    <string name="signed_out_acknowledge">Verstanden</string>

    <!-- Platzhalter-Wallet (T-151); T-153 ersetzt sie durch feature:wallet. -->
    <string name="wallet_empty_title">Deine Karten</string>
    <string name="wallet_empty_body">Hier ist noch nichts. Füge deine erste Karte hinzu, um sie an der Kasse in Sekunden griffbereit zu haben.</string>
    <string name="wallet_add_first_card">Erste Karte hinzufügen</string>

</resources>
