<?xml version="1.0" encoding="UTF-8"?>
<!--
  §7.3 的三条客户端安全设置由 T-009 与 Room + SQLCipher 一并加入 ——
  它们是同一件事的两面：本地库加密了但允许云备份，等于把密文和 Keystore
  包裹一起交出去。

  allowBackup + dataExtractionRules 两条**都要**，不是二选一：前者管备份，
  后者还管 Android 12+ 的设备间直传（D2D），而 D2D 不看 allowBackup。
  详见 res/xml/data_extraction_rules.xml 的注释。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".NcardsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NCards">

        <!--
          §7.3：所有 Activity 默认 exported="false"，仅必要的入口显式导出。
          MainActivity 是启动入口，必须 exported="true"。

          ⚠️ launchMode="singleTop"（T-151）：Magic Link 的 App Link 要落进
          **已经在前台的**这一个实例，由 onNewIntent 接住。默认的 standard
          会再开一个 MainActivity —— 用户点完邮件里的链接会看到两层界面，
          而下面那一层还停在「请输入验证码」。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NCards">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Magic Link（§7.1 / ADR-0016 / T-151）。

              邮件里的链接是 https://app.n-cards.de/l/magic/<token>。App Links
              验证通过时 Android 直接拉起本 Activity，那份 Web 落地页根本不加载。

              ⚠️ **今天验证不会通过**，而且那是已知的：
              `infra/caddy/site/.well-known/assetlinks.json` 渲染出来是 `[]` ——
              仓库里还没有 release keystore，拿不到 sha256_cert_fingerprints。
              填它归 M4（两个 group_vars 的 ncards_android_cert_fingerprints）。
              **两边缺一边，链接都不会直接拉起 App。**

              在那之前链接落到 Web 落地页，用户点页面上的按钮走
              `intent://…;package=de.ncards;end` —— 那条路**显式点名包名**，
              绕开域名校验，照样命中下面这个 filter。所以功能不坏，只少一步。

              ⚠️ debug 变体的 applicationId 是 `de.ncards.debug`（buildType 的
              applicationIdSuffix），而落地页里写死的是 `de.ncards`。手工验的时候
              要么装一个没有后缀的构建，要么直接：
                adb shell am start -a android.intent.action.VIEW \
                  -d "https://app.n-cards.de/l/magic/<token>"

              pathPrefix 是 `/l/` 而不是 `/l/magic/`：`/l/devices/` 与 `/l/security/`
              两个纯说明页也在这个前缀下（T-104 / T-105 的提醒信），将来 App 要接
              它们时不必再动 manifest。MainActivity 只认自己认识的路径，其余忽略。
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="app.n-cards.de"
                    android:pathPrefix="/l/" />
            </intent-filter>
        </activity>

        <!--
          全屏条码页（§10.2 / T-154）。「独立 Activity（便于设置窗口属性）」——
          亮度、FLAG_KEEP_SCREEN_ON、FLAG_SECURE 都是窗口级的，见
          barcode/FullscreenBarcodeActivity.kt 的类注释（那里也写了它为什么
          在 :app 而界面在 feature:carddetail）。

          ⚠️ exported="false"（§7.3 MUST：仅必要的入口显式导出）。
          T-254 的 Widget 与 T-255 的磁贴是**应用内**的 PendingIntent，
          不需要导出；它们经一个绑在 :app 的端口拿到这个 Intent。

          ⚠️ **刻意不写的三样**：
          - `android:configChanges` —— 横竖屏的布局真的不一样（横屏要把一维码
            放大，那是本卡的交付物之一），所以要的就是正常重建。自己吃
            configChanges 等于手写一套重测量逻辑，还会顺手吞掉语言与字体缩放
            的变更。重建的代价是重渲染一次，而条码缓存按 format+value+size
            命中，转回来那一次是内存读。
          - `android:screenOrientation` —— 不覆盖用户的自动旋转设置。代价是
            锁了自动旋转的用户到不了横屏放大，那是他自己的无障碍设置，
            App 不该悄悄绕过它。
          - `showWhenLocked` / `turnScreenOn` —— 会把会员号显示在**锁屏之上**。
            §3.9 的威胁模型 T09 讲的正是「锁屏预览、他人瞥屏」泄露会员号，
            而 §3.4 还规划了可选的生物识别应用锁。§10.2 也没有要求它。
        -->
        <activity
            android:name=".barcode.FullscreenBarcodeActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.NCards.Fullscreen" />

        <!--
          appcompat 的 per-app locales 在 API < 33 上把用户选的语言存进一份
          私有 SharedPreferences，靠的就是这个「服务」（它从不运行，
          enabled=false —— appcompat 只读它的 meta-data）。

          ⚠️ 不写它的话 AppCompatDelegate.setApplicationLocales 在 API < 33 上
          只在**本次进程**里生效：用户下次冷启动又回到系统语言，而且没有任何报错。
          minSdk 是 26，所以「API < 33」是绝大多数设备。

          替代方案是自己存一份并在 attachBaseContext 里 apply —— 那是三十行
          必须自己维护的代码，换掉这九行 XML 不划算。
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
