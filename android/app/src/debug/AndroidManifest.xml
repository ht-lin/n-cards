<?xml version="1.0" encoding="UTF-8"?>
<!--
  只在 debug 构建里合并进来的清单（T-153）。

  ⚠️ 里面的 DebugSeedReceiver 在 release 里**根本不被编译** ——
  它住在 app/src/debug/kotlin/，不是靠 BuildConfig.DEBUG 判断藏起来的。
  理由见那个类的注释。

  android:exported="true" 是必须的：adb shell am broadcast 是一个外部进程。
  这也正是它不能进 release 的原因之一 —— 一个能清空并重建本地库的
  广播入口，暴露给任何装在同一台设备上的应用。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name="de.ncards.debug.DebugSeedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="de.ncards.debug.SEED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
