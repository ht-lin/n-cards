<?xml version="1.0" encoding="UTF-8"?>
<!--
  ⚠️ **德语是默认语言。** 本文件（values/）放德语，英语在 values-en/（§11.1）。
  不存在 values-de/ —— checkGermanIsDefaultLocale 会拦下建它的改动。

  ⚠️ 相同的条目也必须在 values-en/ 里原样再写一遍。想「省掉一样的那几条」
  正是 MissingTranslation（本项目里是 error）存在的理由。
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="de">

    <!-- 标题栏：新建与编辑两套。 -->
    <string name="cardedit_title_create">Karte hinzufügen</string>
    <string name="cardedit_title_edit">Karte bearbeiten</string>
    <string name="cardedit_back">Zurück</string>
    <string name="cardedit_save">Speichern</string>

    <!-- 字段标签。 -->
    <string name="cardedit_label_title">Name</string>
    <string name="cardedit_label_merchant">Händler (optional)</string>
    <string name="cardedit_label_color">Farbe</string>
    <string name="cardedit_label_format">Barcode-Typ</string>
    <string name="cardedit_label_value">Barcode-Nummer</string>
    <string name="cardedit_label_note">Notiz (optional)</string>
    <string name="cardedit_label_expires">Gültig bis (optional)</string>

    <!-- 到期日：没选时的占位，以及清除按钮。 -->
    <string name="cardedit_expires_none">Kein Ablaufdatum</string>
    <string name="cardedit_expires_clear">Ablaufdatum entfernen</string>
    <string name="cardedit_expires_pick">Datum auswählen</string>
    <string name="cardedit_expires_confirm">Übernehmen</string>
    <string name="cardedit_expires_dismiss">Abbrechen</string>

    <!--
      长度上限的提示。%1$d 是上限值 —— 不写死在文案里，因为同一条文案
      给四个字段用（标题 100 / 商家 100 / 备注 2000 / 码值 1024）。
    -->
    <string name="cardedit_problem_blank">Dieses Feld darf nicht leer sein</string>
    <string name="cardedit_problem_too_long_characters">Höchstens %1$d Zeichen</string>
    <string name="cardedit_problem_too_long_bytes">Höchstens %1$d Byte</string>

    <!--
      码值编不出来的原因（T-152 交办：「逐字段的载荷校验与德语文案归 T-155」）。
      每一条都要让用户知道**怎么改**，而不只是「无效」。
    -->
    <string name="cardedit_payload_empty">Bitte die Barcode-Nummer eingeben</string>
    <string name="cardedit_payload_unsupported_format">Dieser Barcode-Typ wird nicht unterstützt</string>
    <string name="cardedit_payload_illegal_characters">„%1$s“ ist für diesen Barcode-Typ nicht zulässig</string>
    <!-- %1$s ist z. B. „12 oder 13“ — von der UI aus der Liste zusammengesetzt. -->
    <string name="cardedit_payload_wrong_length">Dieser Barcode-Typ braucht %1$s Ziffern</string>
    <string name="cardedit_payload_too_long">Höchstens %1$d Zeichen für diesen Barcode-Typ</string>
    <string name="cardedit_payload_odd_length">Dieser Barcode-Typ braucht eine gerade Anzahl Ziffern</string>
    <string name="cardedit_payload_checksum">Die Prüfziffer stimmt nicht</string>
    <string name="cardedit_payload_not_encodable">Dieser Inhalt passt nicht in diesen Barcode-Typ</string>
    <!-- Verbindet zwei erlaubte Längen: „12 oder 13“. -->
    <string name="cardedit_length_or">%1$d oder %2$d</string>

    <!-- 卡没了 / 出错了。与 carddetail 是同一套口径（§16 R12）。 -->
    <string name="cardedit_missing_title">Karte nicht mehr vorhanden</string>
    <string name="cardedit_missing_body">Diese Karte ist nicht mehr in deiner Brieftasche. Vielleicht wurde sie gelöscht oder nicht mehr mit dir geteilt.</string>
    <string name="cardedit_error_user_unknown_title">Daten nicht lesbar</string>
    <string name="cardedit_error_user_unknown_body">Deine Kartendaten lassen sich auf diesem Gerät gerade nicht lesen. Sobald wieder eine Verbindung besteht, ist alles wieder da.</string>

    <!--
      ⚠️ 色板的无障碍文案（§11.2：不以颜色作为唯一信息载体）。
      十一条，与 CardColor.entries 逐个对应 —— 少一条会让那一格在 TalkBack 下
      读成「按钮」，用户完全不知道选的是什么颜色。
    -->
    <string name="cardedit_color_blue">Blau</string>
    <string name="cardedit_color_indigo">Indigo</string>
    <string name="cardedit_color_teal">Petrol</string>
    <string name="cardedit_color_green">Grün</string>
    <string name="cardedit_color_olive">Oliv</string>
    <string name="cardedit_color_orange">Orange</string>
    <string name="cardedit_color_red">Rot</string>
    <string name="cardedit_color_pink">Pink</string>
    <string name="cardedit_color_purple">Violett</string>
    <string name="cardedit_color_brown">Braun</string>
    <string name="cardedit_color_slate">Schiefer</string>
    <!-- Wird an die Farbbezeichnung angehängt, damit der Zustand nicht nur an der Farbe hängt. -->
    <string name="cardedit_color_selected">%1$s, ausgewählt</string>

</resources>
